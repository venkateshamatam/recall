{
  "name": "recall-mcp",
  "version": "0.3.0",
  "description": "One memory pool for every AI agent on your machine. MCP server with shared SQLite-backed memory.",
  "type": "module",
  "bin": {
    "recall": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch -p tsconfig.json",
    "test": "node --test"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.9.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.23.0"
  }
}
